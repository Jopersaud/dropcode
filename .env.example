# Public IP address of the host running coturn (what clients connect to).
PUBLIC_IP=203.0.113.10
# Shared secret between dropcode and coturn. Generate with: openssl rand -hex 32
TURN_SECRET=change-me
# Cloudflare Realtime TURN (managed; no VPS needed). Create a TURN key at
# dash.cloudflare.com -> Realtime -> TURN Keys. Leave unset to use coturn above.
TURN_CLOUDFLARE_KEY_ID=
TURN_CLOUDFLARE_API_TOKEN=

# "relay" forces every transfer through TURN (peers never see each other's IPs).
ICE_TRANSPORT_POLICY=all
# Set to "xff" behind a reverse proxy that sets X-Forwarded-For, or "fly" on Fly.io.
TRUST_PROXY=
